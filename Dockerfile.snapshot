FROM python:3.12-alpine

RUN apk add --no-cache curl sqlite su-exec

WORKDIR /app

COPY dexMonitor/snapshot.py dexMonitor/db/schema.sql ./
COPY dexMonitor/bisq_grpc/ ./bisq_grpc/

RUN pip install --no-cache-dir requests[socks] grpcio protobuf

RUN mkdir -p /app/data

RUN adduser -D appuser && chown -R appuser:appuser /app

USER root

CMD ["sh", "-c", \
    "chown -R appuser:appuser /app/data && \
     if [ ! -f \"$DB_PATH\" ]; then sqlite3 \"$DB_PATH\" < /app/schema.sql; fi && \
     exec su-exec appuser sh -c 'while true; do python /app/snapshot.py; sleep $((SNAPSHOT_INTERVAL_MIN * 60)); done'"]
