# Core runtime
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dexarb
POSTGRES_USER=dex_monitor
POSTGRES_PASSWORD=dex_monitor
DATABASE_URL=postgres://dex_monitor:dex_monitor@localhost:5432/dexarb?sslmode=disable
SNAPSHOT_INTERVAL_MIN=1
FRONTEND_DIR=./react-frontend/dist
MM_CONTROLLER_API_URL=http://localhost:5001
TOR_PROXY_ADDR=127.0.0.1:9050

# Exchange API credentials for live taker / withdrawal fee lookup.
# If unset, dexMonitor falls back to static fee assumptions.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=
BITSTAMP_API_KEY=
BITSTAMP_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=

# Futures / hedge inputs.
# Kraken Futures will also accept KRAKEN_API_KEY / KRAKEN_API_SECRET as fallback.
# Coinbase Futures will also accept COINBASE_API_* as fallback.
KRAKEN_FUTURES_API_KEY=
KRAKEN_FUTURES_API_SECRET=
COINBASE_FUTURES_API_KEY=
COINBASE_FUTURES_API_SECRET=
COINBASE_FUTURES_API_PASSPHRASE=

# Optional hedge config override.
# Leave unset to use the embedded config in internal/hedge/config.json.
DEXMONITOR_HEDGE_CONFIG=

# Optional bisqstats helper service.
STATS_API_ADDR=:9997
BISQ_APP_DATA_DIR=/home/appuser/.local/share/Bisq
