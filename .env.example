# dexMonitor — Environment Variables
# Copy this file to dexMonitor/.env and fill in real secrets locally.
# Under docker-compose most values below are overridden by the compose
# `environment:` block (injected from the ROOT .env), so this file mainly
# matters for standalone runs outside docker.

# Core runtime
# Standalone URL (required by scripts/validate-env-contract.sh). Under
# docker-compose the URL is assembled from POSTGRES_HOST/PORT/DB/USER/PASSWORD.
DATABASE_URL=postgres://dex_monitor:dex_monitor@localhost:5432/dexarb?sslmode=disable
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dexarb
POSTGRES_USER=dex_monitor
POSTGRES_PASSWORD=dex_monitor
SNAPSHOT_INTERVAL_MIN=1
FRONTEND_DIR=./react-frontend/dist
MM_CONTROLLER_API_URL=http://localhost:5001
TOR_PROXY_ADDR=127.0.0.1:9050
# Tor SOCKS proxy URL form (compose sets socks5h://tor:9050 on the bridge network).
TOR_PROXY_URL=socks5h://127.0.0.1:9050

# Upstream APIs (injected from the ROOT .env under docker-compose).
UNIFIED_API_URL=http://localhost:5010
FIAT_CONTROLLER_URL=http://localhost:8080
SERVER_INTERNAL_URL=http://localhost:5010
PRICE_PROVIDER=bisq_tor

# Internal auth (injected from the ROOT .env under docker-compose).
# Every proxied /api/mm-controller/* call carries INTERNAL_API_SECRET.
INTERNAL_API_SECRET=
# Phone-payment callbacks fail closed when empty.
PUSHPUSH_NOTIFY_SECRET=
# Phone reported offline after this time without a heartbeat (default 15m).
PUSHPUSH_HEARTBEAT_MAX_AGE=15m
# 32-byte base64 key for Postgres credential encryption (ROOT .env in compose).
APP_ENCRYPTION_KEY=
# A successful CEX permission snapshot older than this is no longer trusted.
MM_CEX_CAPABILITY_MAX_AGE=30m
# Login session cookie Secure attribute (default true; false for HTTP dev).
SESSION_COOKIE_SECURE=true

# Bisq daemon (compose points these at the bisq container on the bridge network).
BISQ_GRPC_HOST=localhost:9998
BISQ_API_PASSWORD=
# Local SQLite fallback / auxiliary path used by some tooling.
DB_PATH=./sqlite.db

# Optional hedge config override.
# Leave unset to use the embedded config in internal/hedge/config.json.
DEXMONITOR_HEDGE_CONFIG=

# Optional bisqstats helper service.
STATS_API_ADDR=:9997
BISQ_APP_DATA_DIR=/home/appuser/.local/share/Bisq

# Observability (optional; compose injects ROOT .env values with these defaults).
# OTEL_EXPORTER_OTLP_ENDPOINT=alloy:4317
# OTEL_TRACES_SAMPLER_ARG=1.0
# LOG_LEVEL=info
# DEPLOY_ENV=production

# LND read-only access for operator tooling (optional, unset by default).
# LND_HOST=https://localhost:8080
# LND_MACAROON_PATH=/lnd/admin.macaroon
# LND_TLS_CERT_PATH=/lnd/tls.cert
# LND wallet password is stored in Postgres (accounts.password) and edited in
# the dexMonitor Accounts panel — never in this file.
